# Inlined into the bundle at build time by Expo, so EXPO_PUBLIC_ values are
# public by definition. An OAuth *client id* is meant to be public; the client
# secret is not and lives only on the server, in ~/.config/splitwise/google.env.
#
# This is read at build time, so `npm run web:publish` has to be re-run after
# changing it - a running server will not pick it up.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=563634096833-2v4hhc5tjf46ojvih9nehr7n0s04vqh5.apps.googleusercontent.com

# Set once an Android OAuth client exists, to enable the Google button in the
# APK. Google refuses a custom-scheme redirect for a Web client, so the native
# build cannot reuse the id above.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
