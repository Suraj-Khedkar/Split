{
  "expo": {
    "name": "Split & Track",
    "slug": "splitwise-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suraj.splitandtrack",
      "userInterfaceStyle": "automatic",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1CC29F",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.suraj.splitandtrack",
      "userInterfaceStyle": "automatic",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Split & Track uses your photos so you can pick a receipt to scan.",
          "cameraPermission": "Split & Track uses the camera so you can photograph a receipt."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1CC29F"
        }
      ]
    ],
    "scheme": [
      "splitandtrack",
      "com.suraj.splitandtrack"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F9",
      "dark": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0E0F12"
      }
    },
    "extra": {
      "router": {},
      "googleClientId": "563634096833-2v4hhc5tjf46ojvih9nehr7n0s04vqh5.apps.googleusercontent.com",
      "googleAndroidClientId": "563634096833-8r4k6g4a3oci2mmo3346jooq0753kuju.apps.googleusercontent.com",
      "eas": {
        "projectId": "1a265b3c-e92b-4523-bdbf-f0a981b88a2f"
      }
    }
  }
}
