{
  "name": "split-and-track",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-auth-session": "~57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "ws": "^8.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "eas-cli": "^21.6.0",
    "puppeteer": "^25.5.0",
    "tsx": "^4.23.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "REACT_NATIVE_PACKAGER_HOSTNAME=$(tailscale ip -4 | head -1) expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx --test src/lib/__tests__/*.test.ts && node --test server/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "start:lan": "expo start",
    "start:tunnel": "expo start --tunnel",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "web:build": "expo export --platform web --output-dir dist && node scripts/pwa-inject.mjs dist/index.html",
    "web:publish": "npm run web:build && systemctl --user restart splitwise-web"
  },
  "private": true
}
